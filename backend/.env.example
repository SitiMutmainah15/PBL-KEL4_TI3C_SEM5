# Isi dengan kunci dari https://console.groq.com/keys
GROQ_API_KEY=

# Model visi Groq. Qwen 3.8 27B adalah model visi yang tersedia saat ini.
GROQ_MODEL=qwen/qwen3.8-27b

# Batas
MAX_UPLOAD_BYTES=8388608
MAX_CONCURRENT_REQUESTS=4
CACHE_ENTRIES=256
REQUEST_TIMEOUT_SECONDS=45
MAX_IMAGE_EDGE=1024

# Isi bila aplikasi web perlu mengakses backend dari origin lain.
ALLOWED_ORIGINS=
